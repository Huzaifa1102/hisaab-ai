# Google Gemini API Key (Get free key from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_google_ai_studio_key

# Groq API Key for Whisper audio transcription (Get free key from Groq Console: https://console.groq.com/)
GROQ_API_KEY=your_groq_key_for_phase_2

# Default Gemini model (e.g., gemini-3.8-flash). gemini-2.5-flash is no longer available to new users.
GEMINI_MODEL=gemini-3.8-flash

# Optional: ask the model to think less for faster answers (minimal | low | medium | high).
# Leave unset to use the model's default. Not yet tested live; try it before relying on it.
# GEMINI_THINKING_LEVEL=low
