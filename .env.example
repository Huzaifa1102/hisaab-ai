# Primary Google Gemini API Key (Get free key from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_google_ai_studio_key

# Optional Backup Gemini API Keys for Zero-Interruption Rate Limit & Quota Failover
# If GEMINI_API_KEY hits 429 quota exhausted, the system automatically rotates to these:
GEMINI_API_KEY_BACKUP_1=your_backup_gemini_key_1
GEMINI_API_KEY_BACKUP_2=your_backup_gemini_key_2

# Groq API Key for Whisper audio transcription (Get free key from Groq Console: https://console.groq.com/)
GROQ_API_KEY=your_groq_key_for_phase_2

# Default Gemini model (e.g., gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional: ask the model to think less for faster answers (minimal | low | medium | high).
# GEMINI_THINKING_LEVEL=low

# Optional: Direct Background WhatsApp Dispatch via Twilio API
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_WHATSAPP_NUMBER=+14155238886

# Optional: Direct Background WhatsApp Dispatch via Meta WhatsApp Cloud API
# WHATSAPP_CLOUD_TOKEN=your_meta_system_user_token
# WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
